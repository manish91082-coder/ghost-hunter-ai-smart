# Never commit real credentials.
# Use one or more Polygon JSON-RPC endpoints. Free/public endpoints may be rate-limited.
POLYGON_RPC_URLS=
POLYGON_WSS_URLS=

# Optional provider labels in the same order as URLs.
POLYGON_RPC_NAMES=

# Data-plane controls only. These do not weaken economic/safety gates.
RPC_TIMEOUT_SECONDS=3
RPC_MAX_BATCH=50
MAX_LOG_RANGE=2000
STATE_STALE_BLOCKS=2
